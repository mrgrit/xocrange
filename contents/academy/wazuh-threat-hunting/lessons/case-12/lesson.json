          "type": "text",
          "text": "인덱스 패턴"
        },
        {
          "type": "text",
          "text": "wazuh-alerts-*"
        },
        {
          "type": "text",
          "text": "시간 범위"
        },
        {
          "type": "text",
          "text": "Last 15 minutes (실습 직후)"
        },
        {
          "type": "text",
          "text": "DQL — 검색창에 직접 입력 → Enter"
        },
        {
          "type": "text",
          "text": "data.id:5* OR rule.id:(31152 or 31153 or 31154)"
        },
        {
          "type": "text",
          "text": "추가할 컬럼"
        },
        {
          "type": "text",
          "text": "agent.name  ·  rule.id  ·  rule.description  ·  data.srcip  ·  data.id  ·  data.url"
        },
        {
          "type": "text",
          "text": "xOC Range 결과"
        },
        {
          "type": "text",
          "text": "1 hits"
        }
      ]
