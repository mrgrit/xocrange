          "type": "text",
          "text": "Last 15 minutes (실습 직후)"
        },
        {
          "type": "text",
          "text": "DQL — 검색창에 직접 입력 → Enter"
        },
        {
          "type": "text",
          "text": "rule.id:5715 AND data.dstuser:root"
        },
        {
          "type": "text",
          "text": "추가할 컬럼"
        },
