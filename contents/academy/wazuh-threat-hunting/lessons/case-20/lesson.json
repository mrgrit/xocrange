        },
        {
          "type": "text",
          "text": "Wazuh 위협 탐지 DQL 예시집  ·  리눅스 · 20"
        },
        {
          "type": "text",
          "text": "인덱스 패턴"
        },
        {
          "type": "text",
          "text": "wazuh-alerts-*"
        },
        {
          "type": "text",
          "text": "시간 범위"
        },
        {
          "type": "text",
          "text": "Last 15 minutes (실습 직후)"
        },
        {
          "type": "text",
          "text": "DQL — 검색창에 직접 입력 → Enter"
        },
        {
          "type": "text",
          "text": "rule.groups:sudo AND rule.id:(5401 or 5402 or 5403)"
        },
        {
          "type": "text",
          "text": "추가할 컬럼"
        },
        {
          "type": "text",
          "text": "agent.name  ·  rule.id  ·  rule.description  ·  data.srcuser  ·  data.dstuser  ·  data.command"
        },
        {
          "type": "text",
          "text": "xOC Range 결과"
        },
        {
          "type": "text",
          "text": "3 hits"
        }
      ]
