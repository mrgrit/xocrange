        },
        {
          "type": "text",
          "text": "인덱스 패턴"
        },
        {
          "type": "text",
          "text": "wazuh-alerts-*"
        },
        {
          "type": "text",
          "text": "시간 범위"
        },
        {
          "type": "text",
          "text": "Last 15 minutes (실습 직후)"
        },
        {
          "type": "text",
          "text": "DQL — 검색창에 직접 입력 → Enter"
        },
        {
          "type": "text",
          "text": "rule.id:31105 OR data.url:(*\\<script* or *%3Cscript* or *onerror* or *javascript\\:*)"
        },
        {
          "type": "text",
          "text": "추가할 컬럼"
        },
        {
          "type": "text",
