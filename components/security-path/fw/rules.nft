# Own tables only. Never flush a host or another component's ruleset.
add table inet xoc_fw
flush table inet xoc_fw
table inet xoc_fw {
    counter blocked_input {}
    counter forwarded_web {}
    counter forwarded_office {}
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        limit rate 10/second burst 20 packets log prefix "[xoc-fw] DROP " group 10 snaplen 128 queue-threshold 1
        counter name blocked_input drop
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid drop
        ip saddr 10.20.30.0/24 ip daddr 10.20.32.80 tcp dport 8080 ct state new limit rate 10/second burst 20 packets log prefix "[xoc-fw] ACCEPT " group 10 snaplen 128 queue-threshold 1
        ip saddr 10.20.30.0/24 ip daddr 10.20.32.80 tcp dport 8080 counter name forwarded_web accept
        ip saddr 10.20.32.80 ip daddr 10.20.30.0/24 tcp sport 8080 ct state established,related accept
        ip saddr 10.20.30.20 ip daddr 10.20.32.80 tcp dport 8443 ct state new limit rate 10/second burst 20 packets log prefix "[xoc-fw] ACCEPT " group 10 snaplen 128 queue-threshold 1
        ip saddr 10.20.30.20 ip daddr 10.20.32.80 tcp dport 8443 counter name forwarded_web accept
        ip saddr 10.20.32.80 ip daddr 10.20.30.20 tcp sport 8443 ct state established,related accept
        # Office network (ADR 0012): SSH to the office PC, and the office PC to the web gateway.
        ip saddr 10.20.30.0/24 ip daddr 10.20.70.21 tcp dport 22 ct state new limit rate 10/second burst 20 packets log prefix "[xoc-fw] ACCEPT " group 10 snaplen 128 queue-threshold 1
        ip saddr 10.20.30.0/24 ip daddr 10.20.70.21 tcp dport 22 counter name forwarded_office accept
        ip saddr 10.20.70.21 ip daddr 10.20.30.0/24 tcp sport 22 ct state established,related accept
        limit rate 10/second burst 20 packets log prefix "[xoc-fw] DROP " group 10 snaplen 128 queue-threshold 1
    }
}
add table ip xoc_dnat
flush table ip xoc_dnat
table ip xoc_dnat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 10.20.30.1 tcp dport 8080 dnat to 10.20.32.80:8080
        ip saddr 10.20.30.20 ip daddr 10.20.30.1 tcp dport 8443 dnat to 10.20.32.80:8443
        ip saddr 10.20.30.0/24 ip daddr 10.20.30.1 tcp dport 2222 dnat to 10.20.70.21:22
    }
}
