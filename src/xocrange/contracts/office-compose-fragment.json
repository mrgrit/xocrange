{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Reviewed office PC privileges (ADR 0012)",
 "const": {
  "services": {
   "office-pc": {
    "build": {
     "context": ".",
     "dockerfile": "Dockerfile"
    },
    "hostname": "office-pc01",
    "init": true,
    "networks": {
     "office": {
      "ipv4_address": "10.20.70.21"
     }
    },
    "read_only": false,
    "cap_drop": [
     "ALL"
    ],
    "cap_add": [
     "AUDIT_WRITE",
     "CHOWN",
     "DAC_OVERRIDE",
     "FOWNER",
     "KILL",
     "NET_ADMIN",
     "NET_BIND_SERVICE",
     "SETGID",
     "SETPCAP",
     "SETUID",
     "SYS_CHROOT"
    ],
    "restart": "unless-stopped",
    "depends_on": [
     "ips"
    ],
    "volumes": [
     "office-config:/run/xoc-office:ro",
     "office-data:/var/lib/xoc-office",
     "office-home:/home",
     "office-logs:/var/log"
    ]
   }
  },
  "networks": {
   "office": {
    "internal": true,
    "driver": "bridge",
    "driver_opts": {
     "com.docker.network.bridge.enable_ip_masquerade": "false"
    },
    "ipam": {
     "config": [
      {
       "subnet": "10.20.70.0/24",
       "gateway": "10.20.70.254"
      }
     ]
    }
   }
  },
  "volumes": {
   "office-config": {},
   "office-data": {},
   "office-home": {},
   "office-logs": {}
  }
 }
}
