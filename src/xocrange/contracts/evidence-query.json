{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Evidence query v0.2 (ADR-0008; v0.2 adds per-source aggregation for Joint Force skills)",
 "description": "Read-only evidence questions an entitled module asks over its evidence socket, and the answers. Closed parameter sets; patterns are literal substrings. Core returns facts with evidence references, never scores.",
 "oneOf": [
  {
   "$ref": "#/definitions/request"
  },
  {
   "$ref": "#/definitions/result"
  }
 ],
 "definitions": {
  "hash": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
  },
  "time": {
   "type": "string",
   "format": "date-time",
   "pattern": "Z$"
  },
  "literal": {
   "type": "string",
   "minLength": 1,
   "maxLength": 500,
   "pattern": "^[^\\u0000-\\u001f]+$"
  },
  "since_sec": {
   "type": "integer",
   "minimum": 1,
   "maximum": 86400
  },
  "service": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]{0,40}$"
  },
  "path": {
   "type": "string",
   "minLength": 2,
   "maxLength": 240,
   "pattern": "^/(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/@+-]+$"
  },
  "c1_field": {
   "enum": [
    "event.action",
    "event.outcome",
    "event.type",
    "rule.id",
    "network.source.ip",
    "network.destination.ip",
    "network.destination.port",
    "http.request.method",
    "http.response.status_code",
    "url.path",
    "process.name",
    "user.name",
    "file.path",
    "host.name"
   ]
  },
  "check": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "type",
    "target",
    "params"
   ],
   "properties": {
    "id": {
     "$ref": "#/definitions/id"
    },
    "type": {
     "enum": [
      "c1_event",
      "wazuh_alert",
      "log_contains",
      "device_config",
      "file_exists",
      "file_contains",
      "file_hash",
      "port_listening",
      "process_running",
      "c1_aggregate"
     ]
    },
    "target": {
     "$ref": "#/definitions/service"
    },
    "params": {
     "type": "object"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "c1_event"
       }
      }
     },
     "then": {
      "properties": {
       "target": {
        "const": "siem"
       },
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "producer"
        ],
        "properties": {
         "producer": {
          "enum": [
           "suricata",
           "modsecurity",
           "nftables",
           "osquery",
           "sysmon",
           "auditd",
           "apache-access",
           "apache-error"
          ]
         },
         "where": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
           "$ref": "#/definitions/c1_field"
          },
          "additionalProperties": {
           "type": [
            "string",
            "integer"
           ],
           "maxLength": 200
          }
         },
         "contains": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "field",
           "value"
          ],
          "properties": {
           "field": {
            "$ref": "#/definitions/c1_field"
           },
           "value": {
            "$ref": "#/definitions/literal"
           }
          }
         },
         "source_is_attacker": {
          "type": "boolean"
         },
         "min_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
         },
         "since_sec": {
          "$ref": "#/definitions/since_sec"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "wazuh_alert"
       }
      }
     },
     "then": {
      "properties": {
       "target": {
        "const": "siem"
       },
       "params": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
         {
          "required": [
           "rule_id"
          ]
         },
         {
          "required": [
           "groups"
          ]
         },
         {
          "required": [
           "pattern"
          ]
         }
        ],
        "properties": {
         "rule_id": {
          "type": "string",
          "pattern": "^[0-9]{1,8}$"
         },
         "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
           "type": "string",
           "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          }
         },
         "pattern": {
          "$ref": "#/definitions/literal"
         },
         "min_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
         },
         "since_sec": {
          "$ref": "#/definitions/since_sec"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "log_contains"
       }
      }
     },
     "then": {
      "properties": {
       "target": {
        "enum": [
         "fw",
         "ips",
         "web"
        ]
       },
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "log",
         "pattern"
        ],
        "properties": {
         "log": {
          "enum": [
           "nftables",
           "suricata",
           "modsec",
           "apache-access",
           "apache-error"
          ]
         },
         "pattern": {
          "$ref": "#/definitions/literal"
         },
         "since_sec": {
          "$ref": "#/definitions/since_sec"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "device_config"
       }
      }
     },
     "then": {
      "properties": {
       "target": {
        "enum": [
         "fw",
         "ips",
         "waf",
         "siem"
        ]
       },
       "params": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
         {
          "required": [
           "contains"
          ]
         },
         {
          "required": [
           "absent"
          ]
         }
        ],
        "properties": {
         "contains": {
          "$ref": "#/definitions/literal"
         },
         "absent": {
          "$ref": "#/definitions/literal"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "file_exists"
       }
      }
     },
     "then": {
      "properties": {
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "path"
        ],
        "properties": {
         "path": {
          "$ref": "#/definitions/path"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "file_contains"
       }
      }
     },
     "then": {
      "properties": {
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "path",
         "pattern"
        ],
        "properties": {
         "path": {
          "$ref": "#/definitions/path"
         },
         "pattern": {
          "$ref": "#/definitions/literal"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "file_hash"
       }
      }
     },
     "then": {
      "properties": {
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "path",
         "sha256"
        ],
        "properties": {
         "path": {
          "$ref": "#/definitions/path"
         },
         "sha256": {
          "$ref": "#/definitions/hash"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "port_listening"
       }
      }
     },
     "then": {
      "properties": {
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "port"
        ],
        "properties": {
         "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
         },
         "protocol": {
          "enum": [
           "tcp",
           "udp"
          ]
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "process_running"
       }
      }
     },
     "then": {
      "properties": {
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "name"
        ],
        "properties": {
         "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "c1_aggregate"
       }
      }
     },
     "then": {
      "properties": {
       "target": {
        "const": "siem"
       },
       "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "group_by",
         "since_days"
        ],
        "properties": {
         "group_by": {
          "const": "network.source.ip"
         },
         "since_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
         },
         "producers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
           "enum": [
            "suricata",
            "modsecurity",
            "nftables",
            "osquery",
            "sysmon",
            "auditd",
            "apache-access",
            "apache-error"
           ]
          }
         },
         "business_hours": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "start",
           "end",
           "weekdays",
           "utc_offset_minutes"
          ],
          "properties": {
           "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
           },
           "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
           },
           "weekdays": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
             "type": "integer",
             "minimum": 0,
             "maximum": 6
            }
           },
           "utc_offset_minutes": {
            "type": "integer",
            "minimum": -720,
            "maximum": 840
           }
          }
         },
         "top": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
         },
         "min_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
         }
        }
       }
      }
     }
    }
   ]
  },
  "request": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_version",
    "request_id",
    "checks"
   ],
   "properties": {
    "schema_version": {
     "enum": [
      "xoc.evidence-query/0.1.0",
      "xoc.evidence-query/0.2.0"
     ]
    },
    "request_id": {
     "$ref": "#/definitions/id"
    },
    "window": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "since",
      "until"
     ],
     "properties": {
      "since": {
       "$ref": "#/definitions/time"
      },
      "until": {
       "$ref": "#/definitions/time"
      }
     }
    },
    "attacker_ips": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "string",
      "anyOf": [
       {
        "format": "ipv4"
       },
       {
        "format": "ipv6"
       }
      ]
     }
    },
    "checks": {
     "type": "array",
     "minItems": 1,
     "maxItems": 32,
     "items": {
      "$ref": "#/definitions/check"
     }
    }
   }
  },
  "result": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_version",
    "request_id",
    "evaluated_at",
    "results"
   ],
   "properties": {
    "schema_version": {
     "enum": [
      "xoc.evidence-result/0.1.0",
      "xoc.evidence-result/0.2.0"
     ]
    },
    "request_id": {
     "$ref": "#/definitions/id"
    },
    "evaluated_at": {
     "$ref": "#/definitions/time"
    },
    "results": {
     "type": "array",
     "maxItems": 32,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "check_id",
       "params_sha256",
       "result",
       "evidence"
      ],
      "properties": {
       "check_id": {
        "$ref": "#/definitions/id"
       },
       "params_sha256": {
        "$ref": "#/definitions/hash"
       },
       "result": {
        "enum": [
         "passed",
         "failed",
         "inconclusive",
         "error"
        ]
       },
       "count": {
        "type": "integer",
        "minimum": 0
       },
       "reason": {
        "type": "string",
        "maxLength": 500
       },
       "evidence": {
        "type": "array",
        "maxItems": 16,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "kind",
          "ref",
          "sha256"
         ],
         "properties": {
          "kind": {
           "enum": [
            "c1_event",
            "alert",
            "device_config",
            "service_state",
            "file"
           ]
          },
          "ref": {
           "type": "string",
           "minLength": 1,
           "maxLength": 256
          },
          "sha256": {
           "$ref": "#/definitions/hash"
          },
          "observed_at": {
           "$ref": "#/definitions/time"
          },
          "excerpt": {
           "type": "string",
           "maxLength": 1000
          }
         }
        }
       },
       "groups": {
        "type": "array",
        "maxItems": 200,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "key",
          "events",
          "distinct_days",
          "active_hours",
          "first_seen",
          "last_seen",
          "producers",
          "top_rules",
          "destination_ports"
         ],
         "properties": {
          "key": {
           "type": "string",
           "minLength": 1,
           "maxLength": 64
          },
          "events": {
           "type": "integer",
           "minimum": 0
          },
          "distinct_days": {
           "type": "integer",
           "minimum": 0
          },
          "active_hours": {
           "type": "integer",
           "minimum": 0
          },
          "off_hours": {
           "type": "integer",
           "minimum": 0
          },
          "first_seen": {
           "$ref": "#/definitions/time"
          },
          "last_seen": {
           "$ref": "#/definitions/time"
          },
          "producers": {
           "type": "object",
           "maxProperties": 8,
           "propertyNames": {
            "enum": [
             "suricata",
             "modsecurity",
             "nftables",
             "osquery",
             "sysmon",
             "auditd",
             "apache-access",
             "apache-error"
            ]
           },
           "additionalProperties": {
            "type": "integer",
            "minimum": 0
           }
          },
          "top_rules": {
           "type": "array",
           "maxItems": 5,
           "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "id",
             "count"
            ],
            "properties": {
             "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
             },
             "count": {
              "type": "integer",
              "minimum": 0
             }
            }
           }
          },
          "destination_ports": {
           "type": "integer",
           "minimum": 0
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}