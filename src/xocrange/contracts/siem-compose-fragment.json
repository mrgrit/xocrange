{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Builtin SIEM analysis role; exact role policy is mandatory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "services",
    "networks",
    "volumes"
  ],
  "properties": {
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siem"
      ],
      "properties": {
        "siem": {
          "$ref": "#/definitions/service"
        }
      }
    },
    "networks": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(user|ext|pipe|dmz|int|app|ot|office)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "internal"
          ],
          "properties": {
            "internal": {
              "type": "boolean"
            },
            "driver": {
              "const": "bridge"
            },
            "driver_opts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "com.docker.network.bridge.enable_ip_masquerade": {
                  "const": "false"
                }
              }
            },
            "ipam": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "config"
              ],
              "properties": {
                "config": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "subnet",
                      "gateway"
                    ],
                    "properties": {
                      "subnet": {
                        "type": "string"
                      },
                      "gateway": {
                        "type": "string",
                        "format": "ipv4"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "volumes": {
      "const": {
        "siem-logs": {},
        "siem-etc": {},
        "siem-api": {},
        "siem-queue": {},
        "siem-var": {},
        "siem-config": {}
      }
    }
  },
  "definitions": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networks",
        "read_only",
        "user",
        "cap_drop",
        "security_opt",
        "cap_add",
        "volumes",
        "tmpfs",
        "hostname"
      ],
      "anyOf": [
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "build"
          ]
        }
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context",
            "dockerfile"
          ],
          "properties": {
            "context": {
              "type": "string"
            },
            "dockerfile": {
              "type": "string"
            }
          }
        },
        "command": {
          "$ref": "#/definitions/strings"
        },
        "entrypoint": {
          "$ref": "#/definitions/strings"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "depends_on": {
          "$ref": "#/definitions/strings"
        },
        "networks": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "user",
                  "ext",
                  "pipe",
                  "dmz",
                  "int",
                  "app",
                  "ot",
                  "office"
                ]
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ipv4_address": {
                    "type": "string",
                    "format": "ipv4"
                  }
                }
              }
            }
          ]
        },
        "read_only": {
          "const": true
        },
        "user": {
          "const": "0:0"
        },
        "cap_drop": {
          "const": [
            "ALL"
          ]
        },
        "security_opt": {
          "const": [
            "no-new-privileges:true"
          ]
        },
        "restart": {
          "enum": [
            "no",
            "unless-stopped",
            "on-failure"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "published",
              "host_ip",
              "protocol"
            ],
            "properties": {
              "target": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "published": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "host_ip": {
                "type": "string",
                "anyOf": [
                  {
                    "format": "ipv4"
                  },
                  {
                    "format": "ipv6"
                  }
                ]
              },
              "protocol": {
                "enum": [
                  "tcp",
                  "udp"
                ]
              }
            }
          }
        },
        "cap_add": {
          "const": [
            "CHOWN",
            "DAC_OVERRIDE",
            "FOWNER",
            "KILL",
            "SETUID",
            "SETGID",
            "SYS_CHROOT"
          ]
        },
        "sysctls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "net.ipv4.ip_forward": {
              "enum": [
                "0",
                "1"
              ]
            }
          }
        },
        "tmpfs": {
          "const": [
            "/run:size=16m,mode=0755",
            "/var/ossec/var/run:size=16m,mode=0750,uid=999,gid=999",
            "/var/ossec/tmp:size=32m,mode=0770,uid=999,gid=999",
            "/tmp:size=16m,mode=1777"
          ]
        },
        "volumes": {
          "const": [
            "siem-logs:/var/ossec/logs",
            "siem-etc:/var/ossec/etc",
            "siem-api:/var/ossec/api/configuration",
            "siem-queue:/var/ossec/queue",
            "siem-var:/var/ossec/var",
            "siem-config:/run/xoc-manager:ro"
          ]
        },
        "hostname": {
          "const": "xoc-manager"
        }
      }
    }
  }
}
