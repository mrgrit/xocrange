{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restricted bootstrap Compose fragment (not the complete Compose specification)",
  "type": "object", "additionalProperties": false, "required": ["services", "networks"],
  "properties": {
    "services": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {"^[a-z][a-z0-9-]{0,62}$": {"$ref": "#/definitions/service"}}
    },
    "networks": {
      "type": "object", "additionalProperties": false,
      "patternProperties": {"^(user|ext|pipe|dmz|int|app|ot)$": {
        "type": "object", "additionalProperties": false,
        "required": ["internal"], "properties": {"internal": {"type": "boolean"}}
      }}
    }
  },
  "definitions": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["networks", "read_only", "user", "cap_drop", "security_opt"],
      "anyOf": [{"required": ["image"]}, {"required": ["build"]}],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "build": {
          "type": "object", "additionalProperties": false, "required": ["context", "dockerfile"],
          "properties": {"context": {"type": "string"}, "dockerfile": {"type": "string"}}
        },
        "command": {"$ref": "#/definitions/strings"},
        "entrypoint": {"$ref": "#/definitions/strings"},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "depends_on": {"$ref": "#/definitions/strings"},
        "networks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "read_only": {"const": true},
        "user": {"type": "string", "pattern": "^[1-9][0-9]*(?::[1-9][0-9]*)?$"},
        "cap_drop": {"const": ["ALL"]},
        "security_opt": {"const": ["no-new-privileges:true"]},
        "restart": {"enum": ["no", "unless-stopped", "on-failure"]},
        "ports": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["target", "published", "host_ip", "protocol"],
          "properties": {
            "target": {"type": "integer", "minimum": 1, "maximum": 65535},
            "published": {"type": "integer", "minimum": 1, "maximum": 65535},
            "host_ip": {"type": "string", "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}]},
            "protocol": {"enum": ["tcp", "udp"]}
          }
        }}
      }
    }
  }
}
