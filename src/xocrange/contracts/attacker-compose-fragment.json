{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Reviewed attack terminal privileges (ADR 0013)",
 "const": {
  "services": {
   "attacker": {
    "build": {
     "context": ".",
     "dockerfile": "Dockerfile"
    },
    "hostname": "attacker",
    "init": true,
    "networks": {
     "ext": {
      "ipv4_address": "10.20.30.202"
     }
    },
    "read_only": false,
    "cap_drop": [
     "ALL"
    ],
    "cap_add": [
     "AUDIT_WRITE",
     "CHOWN",
     "DAC_OVERRIDE",
     "FOWNER",
     "KILL",
     "NET_ADMIN",
     "NET_BIND_SERVICE",
     "NET_RAW",
     "SETGID",
     "SETPCAP",
     "SETUID",
     "SYS_CHROOT"
    ],
    "restart": "unless-stopped",
    "depends_on": [
     "fw"
    ],
    "volumes": [
     "attacker-config:/run/xoc-attacker:ro",
     "attacker-data:/var/lib/xoc-attacker",
     "attacker-home:/home"
    ]
   }
  },
  "networks": {
   "ext": {
    "internal": true,
    "driver": "bridge",
    "driver_opts": {
     "com.docker.network.bridge.enable_ip_masquerade": "false"
    },
    "ipam": {
     "config": [
      {
       "subnet": "10.20.30.0/24",
       "gateway": "10.20.30.254"
      }
     ]
    }
   }
  },
  "volumes": {
   "attacker-config": {},
   "attacker-data": {},
   "attacker-home": {}
  }
 }
}
