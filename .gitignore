# Local source preservation and runtime state; never release these artifacts.
/.local/
/.venv/
/.env
/.env.*
!/.env.example
/secrets/
/keys/
/state/
/backups/
/build/
/dist/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Pinned external content module, populated by scripts/fetch-contents.py.
/contents/
/.content-download-*/
